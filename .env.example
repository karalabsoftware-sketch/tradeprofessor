# Postgres connection string (Neon or Supabase free tier).
# Neon:     postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: use the "Transaction pooler" URI from Project Settings > Database.
DATABASE_URL=

# Secret the external scheduler must send as "Authorization: Bearer <CRON_SECRET>"
# to POST /api/cron/evaluate. Generate with: openssl rand -hex 32
CRON_SECRET=

# Separate secret for the admin halt-reset route (POST /api/admin/reset-halt).
# Must be different from CRON_SECRET. Generate with: openssl rand -hex 32
ADMIN_SECRET=
